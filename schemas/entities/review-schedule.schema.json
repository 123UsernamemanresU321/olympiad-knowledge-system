{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olympiad.local/schemas/entities/review-schedule.schema.json",
  "title": "Review Schedule",
  "type": "object",
  "additionalProperties": false,
  "description": "Current spaced-review state for one learner and one target entity.",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rev\\.[a-z0-9-]+$"
    },
    "entity_type": {
      "const": "review_schedule"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "learner_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]{3,100}$"
    },
    "target_ref": {
      "$ref": "../common/entity-ref.schema.json"
    },
    "algorithm": {
      "$ref": "../enums/enums.schema.json#/$defs/review_algorithm"
    },
    "status": {
      "$ref": "../enums/enums.schema.json#/$defs/review_status"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "interval_days": {
      "type": "number",
      "minimum": 0
    },
    "repetition_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ease_factor": {
      "type": "number",
      "minimum": 1.3,
      "maximum": 3.5
    },
    "stability": {
      "type": "number",
      "minimum": 0
    },
    "difficulty_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "suspended_until": {
      "type": "string",
      "format": "date-time"
    },
    "linked_progress_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^prog\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "audit": {
      "$ref": "../common/audit-meta.schema.json"
    }
  },
  "required": [
    "id",
    "entity_type",
    "schema_version",
    "learner_id",
    "target_ref",
    "algorithm",
    "status",
    "due_at",
    "interval_days",
    "repetition_count",
    "audit"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "algorithm": {
            "const": "sm2"
          }
        },
        "required": [
          "algorithm"
        ]
      },
      "then": {
        "required": [
          "ease_factor"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "suspended"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "suspended_until"
        ]
      }
    }
  ]
}
