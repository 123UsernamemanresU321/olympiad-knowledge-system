{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olympiad.local/schemas/entities/definition.schema.json",
  "title": "Definition",
  "type": "object",
  "additionalProperties": false,
  "description": "Canonical mathematical definition, notation entry, or convention.",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^def\\.(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
    },
    "entity_type": {
      "const": "definition"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "$ref": "../enums/enums.schema.json#/$defs/content_status"
    },
    "definition_kind": {
      "$ref": "../enums/enums.schema.json#/$defs/definition_kind"
    },
    "primary_topic_id": {
      "type": "string",
      "pattern": "^(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "statement": {
      "$ref": "../common/math-content.schema.json"
    },
    "tracking_profile": {
      "$ref": "../common/tracking-profile.schema.json"
    },
    "secondary_topic_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "notation": {
      "type": "array",
      "items": {
        "$ref": "../common/notation-item.schema.json"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "../common/math-content.schema.json"
      }
    },
    "equivalent_definition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^def\\.(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "related_theorem_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^thm\\.(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "related_technique_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tech\\.(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "example_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ex\\.(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "problem_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^prob\\.(nt|alg|comb|geo|meta)\\.[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "relation_refs": {
      "type": "array",
      "items": {
        "$ref": "../common/relation-ref.schema.json"
      }
    },
    "audit": {
      "$ref": "../common/audit-meta.schema.json"
    }
  },
  "required": [
    "id",
    "entity_type",
    "schema_version",
    "status",
    "definition_kind",
    "primary_topic_id",
    "term",
    "slug",
    "statement",
    "tracking_profile",
    "audit"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "definition_kind": {
            "const": "notation"
          }
        },
        "required": [
          "definition_kind"
        ]
      },
      "then": {
        "properties": {
          "notation": {
            "minItems": 1
          }
        },
        "required": [
          "notation"
        ]
      }
    }
  ]
}
