  "statement": {
    "source_format": "dual",
    "plain_text": "For integers a, b, and n with n > 0, we write a ≡ b (mod n) when n divides a - b.",
    "markdown": "For integers $a$, $b$, and $n$ with $n>0$, we write $a \\equiv b \\pmod n$ when $n$ divides $a-b$.",
    "latex": "a \\equiv b \\pmod n \\iff n \\mid (a-b)"
  },
